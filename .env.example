# Sanity: the content store.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# Write token. Needed by npm run seed and by /admin. Never commit the value.
SANITY_API_WRITE_TOKEN=

# Shared secret the Sanity webhook sends to /api/revalidate.
SANITY_REVALIDATE_SECRET=

# Single-editor admin password. Unset leaves /admin closed.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Optional: canonical origin for sitemap/OG/JSON-LD if it differs from
# ismailhossain.dev (previews fall back to the Vercel deployment URL).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ==============================================================================
# Indie App Marketplace Settings
# ==============================================================================

# Database
# If DATABASE_URL is unset, SQLite is used automatically at MARKETPLACE_DB_PATH.
MARKETPLACE_DB_PATH=./data/marketplace.db
DATABASE_URL=

# Cryptographic secret for signing download tokens and magic links (min 32 chars)
DOWNLOAD_SECRET=change-this-to-a-secure-random-secret-in-production

# Payment Gateways (sandbox | bkash | sslcommerz)
DEFAULT_GATEWAY=sandbox

# bKash API Credentials (sandbox / live)
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta

# SSLCommerz Credentials (sandbox / live)
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWD=
SSLCOMMERZ_IS_SANDBOX=true

# Storage Provider for Installers (local | r2 | s3)
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./storage/releases
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Email Service (console | resend)
EMAIL_SERVICE=console
RESEND_API_KEY=
EMAIL_FROM="Ismail <store@ismailhossain.dev>"

# Admin API Key for automated release publishing (CI/CD)
RELEASE_PUBLISH_SECRET=change-this-release-secret-in-production

# Protect the reconciliation endpoint. Invoke it from your hosting scheduler.
CRON_SECRET=
STORAGE_REGION=auto
